<div class="page-header">
  <div>
    <h1>Orders</h1>
    <p class="page-subtitle">Management of all received orders</p>
  </div>
</div>

<div class="stats-grid" style="margin-bottom: 2rem;">
  <div class="stat-card">
    <div class="stat-number"><%= @pending_count %></div>
    <div class="stat-label">Pending</div>
  </div>
  <div class="stat-card">
    <div class="stat-number"><%= @confirmed_count %></div>
    <div class="stat-label">Confirmed</div>
  </div>
  <div class="stat-card">
    <div class="stat-number"><%= @shipped_count %></div>
    <div class="stat-label">Shipped</div>
  </div>
  <div class="stat-card">
    <div class="stat-number"><%= @orders.count %></div>
    <div class="stat-label">Total</div>
  </div>
</div>

<div class="table-wrap">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Reference</th>
        <th>Customer</th>
        <th>Product(s)</th>
        <th>Total</th>
        <th>Status</th>
        <th>Date</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if @orders.empty? %>
        <tr><td colspan="7" style="text-align: center; padding: 2rem; color: #666;">No orders yet.</td></tr>
      <% else %>
        <% @orders.each do |order| %>
          <tr>
            <td><code><%= order.reference %></code></td>
            <td>
              <strong><%= order.customer_name %></strong><br>
              <small style="color:#666"><%= order.customer_email %></small>
            </td>
            <td>
              <% order.order_items.each do |item| %>
                <div><%= item.product_name %> <span style="color:#888">×<%= item.quantity %></span></div>
              <% end %>
            </td>
            <td><strong><%= order.total %></strong></td>
            <td><span class="badge badge-<%= order.status_color %>"><%= order.status_label %></span></td>
            <td><small><%= order.created_at.strftime("%d/%m/%Y %H:%M") %></small></td>
            <td>
              <%= link_to "View", admin_order_path(order), class: "btn btn-outline btn-sm" %>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>
