<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Easy VTA — Precision Tonearm Adjustment Tools" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Precision VTA adjustment devices for audiophiles. Micrometric control of your tonearm's Vertical Tracking Angle — on the fly.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
